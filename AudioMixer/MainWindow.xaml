<Window x:Class="AudioMixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AudioMixer.ViewModels"
        xmlns:ctrl="clr-namespace:AudioMixer.Controls"
        mc:Ignorable="d"
        Title="AudioMixer"
        Icon="Assets/app.ico"
        Height="320"
        Width="500"
        ResizeMode="CanMinimize"
        SizeToContent="Manual"
        Background="#1E1E22" Foreground="#EEE"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9AA4"/>
            <Setter Property="FontSize" Value="9"/>
        </Style>

        <Style x:Key="Strip" TargetType="Border">
            <Setter Property="Background" Value="#26262C"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Background" Value="#3A3A42"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="BorderBrush" Value="#4A4A52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#48485A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2E2E34"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecordBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Foreground" Value="#FF5050"/>
        </Style>

        <Style x:Key="DeviceSelBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2A2A30"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="#888" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34343C"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#3A3A48"/>
                    <Setter Property="BorderBrush" Value="#5A6080"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PopupSurface" TargetType="Border">
            <Setter Property="Background" Value="#1B1B22"/>
            <Setter Property="BorderBrush" Value="#5A5A66"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style x:Key="PopupList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MaxHeight" Value="280"/>
            <Setter Property="MinWidth" Value="220"/>
        </Style>

        <Style x:Key="MuteBtn" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Content" Value="&#xE767;"/>
            <Setter Property="ToolTip" Value="Mute"/>
            <Setter Property="Background" Value="#3A3A42"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="BorderBrush" Value="#4A4A52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#D03030"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Content" Value="&#xE74F;"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RouteBtn" TargetType="ToggleButton">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="1,0,0,0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#3A3A42"/>
            <Setter Property="Foreground" Value="#9A9AA4"/>
            <Setter Property="BorderBrush" Value="#4A4A52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#F2A93B"/>
                    <Setter Property="Foreground" Value="#1A1A1F"/>
                    <Setter Property="BorderBrush" Value="#F2A93B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GearBtn" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#3A3A42"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#4A4A52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasAdvancedSettings}" Value="True">
                    <Setter Property="Foreground" Value="#F2A93B"/>
                    <Setter Property="BorderBrush" Value="#F2A93B"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#48485A"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#3A3A48"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DelayBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EditableLabel" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="ToolTip" Value="Click to rename"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A30"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#2A2A30"/>
                    <Setter Property="BorderBrush" Value="#5A5A66"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#16161A" Padding="4,3">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE897;"
                        ToolTip="Help — open documentation on GitHub"
                        Command="{Binding OpenDocumentationCommand}" Margin="4,0,0,0"/>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="Refresh devices" Command="{Binding RefreshDevicesCommand}"/>
                <Button Style="{StaticResource IconBtn}" Content="&#xE895;" ToolTip="Resync audio: restart inputs &amp; outputs (recovers a stalled mic or creeping delay)" Command="{Binding ResyncAudioCommand}"/>
                <Rectangle Width="1" Fill="#3A3A42" Margin="3,2"/>
                <Button Style="{StaticResource IconBtn}" Content="&#xE916;" ToolTip="Detect input delays (clap test)" Command="{Binding DetectDelaysCommand}"/>
                <Button Style="{StaticResource RecordBtn}" FontFamily="Segoe UI" FontSize="12"
                        Content="{Binding InputDiagRecordIcon}" ToolTip="{Binding InputDiagRecordTooltip}"
                        Command="{Binding RecordInputsCommand}"/>
                <Rectangle Width="1" Fill="#3A3A42" Margin="3,2"/>
                <TextBlock Text="Inputs" Foreground="#9A9AA4" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox ItemsSource="{Binding InputCountOptions}"
                          SelectedItem="{Binding InputCount, Mode=TwoWay}"
                          Width="44" Height="20" FontSize="11"
                          VerticalContentAlignment="Center"
                          ToolTip="Number of input channels (1–10)"/>
                <TextBlock Text="{Binding StatusText}" Foreground="#888" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            </DockPanel>
        </Border>

        <!-- VB-CABLE suggestion banner (only when not installed and not dismissed) -->
        <Border DockPanel.Dock="Top" Background="#2B2517" BorderBrush="#5A4A1E" BorderThickness="0,0,0,1"
                Padding="8,4" Visibility="{Binding ShowVbCablePrompt, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="#F2A93B" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <Button DockPanel.Dock="Right" Content="&#xE711;" Command="{Binding DismissVbCablePromptCommand}"
                        FontFamily="Segoe MDL2 Assets" FontSize="10"
                        VerticalAlignment="Center" Margin="6,0,0,0" Padding="4,1" Cursor="Hand"
                        Background="Transparent" Foreground="#C0B79E" BorderThickness="0"
                        ToolTip="Dismiss (don't show this again)"/>
                <Button DockPanel.Dock="Right" Content="Download" Command="{Binding DownloadVbCableCommand}"
                        VerticalAlignment="Center" Margin="8,0,0,0" Padding="8,1" FontSize="11" Cursor="Hand"
                        Background="#F2A93B" Foreground="#1A1A1F" BorderThickness="0"
                        ToolTip="Open vb-audio.com/Cable in your browser"/>
                <TextBlock VerticalAlignment="Center" Foreground="#E8DCC0" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="VB-CABLE not detected — it's needed to send the mix to Zoom as a virtual microphone."
                           Text="VB-CABLE not detected — needed to send the mix to Zoom as a virtual mic."/>
            </DockPanel>
        </Border>

        <!-- Main grid -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <!-- Inputs -->
            <ItemsControl Grid.Column="0" ItemsSource="{Binding Channels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChannelViewModel}">
                        <Border Style="{StaticResource Strip}" MinWidth="86">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*" MinHeight="60"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="1,0,3,0" VerticalAlignment="Center">
                                        <StackPanel.Resources>
                                            <Style x:Key="BusLetter" TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="7"/>
                                                <Setter Property="Foreground" Value="#8A93A0"/>
                                                <Setter Property="Width" Value="7"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="TextAlignment" Value="Center"/>
                                            </Style>
                                        </StackPanel.Resources>
                                        <ItemsControl ItemsSource="{Binding Routes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <TextBlock Style="{StaticResource BusLetter}"
                                                                   Text="{Binding ShortLabel}"/>
                                                        <Ellipse Width="7" Height="7" ToolTip="{Binding LedTooltip}">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="#333842"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsOn}" Value="True"/>
                                                                                <Condition Binding="{Binding IsDucking}" Value="False"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Fill" Value="#3FB950"/>
                                                                        </MultiDataTrigger>
                                                                        <DataTrigger Binding="{Binding IsDucking}" Value="True">
                                                                            <Setter Property="Fill" Value="#F2A93B"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource EditableLabel}"
                                             Text="{Binding CustomLabel, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="20"/>
                                    <Grid Grid.Column="2">
                                        <ToggleButton x:Name="AdvBtn" Style="{StaticResource GearBtn}" Content="&#xE713;"
                                                      ToolTip="Advanced: delay &amp; auto-mix"/>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=AdvBtn}"
                                               PlacementTarget="{Binding ElementName=AdvBtn}"
                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                            <Border Style="{StaticResource PopupSurface}">
                                                <StackPanel MinWidth="200" Margin="6">
                                                    <TextBlock Style="{StaticResource Lbl}" Text="DELAY (ms)"/>
                                                    <Grid Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="42"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider Grid.Column="0" Minimum="0" Maximum="1000" Value="{Binding DelayMs}"
                                                                SmallChange="5" LargeChange="50" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Style="{StaticResource DelayBox}"
                                                                 Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,0,0"/>
                                                    </Grid>
                                                    <CheckBox Margin="0,10,0,0" IsChecked="{Binding IsPriority}"
                                                              Foreground="#DDD" FontSize="11"
                                                              Content="Priority mic (always on, ducks others while speaking)"
                                                              ToolTip="Always full level and out of the competition; while this mic is speaking it ducks the other (room) mics — e.g. a presenter's lapel"/>
                                                    <Border Height="1" Background="#3A3A42" Margin="0,10,0,6"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Style="{StaticResource Lbl}" Text="MIC CLARITY (auto-mix)" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Foreground="#3FB950" FontSize="11" FontWeight="SemiBold"
                                                                   Text="{Binding ClarityText}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ClarityBar, Mode=OneWay}"
                                                                 Height="5" Margin="0,3,0,0"
                                                                 Background="#26262C" Foreground="#3FB950" BorderThickness="0"/>
                                                    <TextBlock Margin="0,4,0,0" Foreground="#777" FontSize="9" TextWrapping="Wrap"
                                                               Text="How close/clean this mic sounds vs the others (crest factor). Higher wins the auto-mix. Shows '—' until it hears speech."/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <ToggleButton x:Name="DevBtn" Style="{StaticResource DeviceSelBtn}"
                                                  Content="{Binding SelectedDevice.FriendlyName, FallbackValue='(none)', TargetNullValue='(none)'}"
                                                  ToolTip="{Binding SelectedDevice.FriendlyName, FallbackValue='Click to pick a device'}"/>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=DevBtn}"
                                           PlacementTarget="{Binding ElementName=DevBtn}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Style="{StaticResource PopupSurface}">
                                            <StackPanel MinWidth="220">
                                                <Button Content="✕  Clear device" HorizontalContentAlignment="Left"
                                                        Background="Transparent" Foreground="#C99" BorderThickness="0"
                                                        Padding="6,3" FontSize="11" Cursor="Hand"
                                                        Command="{Binding ClearDeviceCommand}"
                                                        Tag="{Binding ElementName=DevBtn}"
                                                        Click="ClosePopup_Click"/>
                                                <Border Height="1" Background="#3A3A42" Margin="2,1"/>
                                                <ListBox Style="{StaticResource PopupList}"
                                                         ItemsSource="{Binding AvailableDevices}"
                                                         SelectedItem="{Binding SelectedDevice}"
                                                         DisplayMemberPath="FriendlyName"
                                                         Tag="{Binding ElementName=DevBtn}"
                                                         SelectionChanged="PopupList_SelectionChanged"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ctrl:VuMeter Grid.Column="0"
                                                  PeakDb="{Binding InputPeakDb}"
                                                  HoldDb="{Binding InputPeakHoldDb}"
                                                  Orientation="Vertical"
                                                  ToolTip="Pre-fader level"/>
                                    <ctrl:VuMeter Grid.Column="1"
                                                  PeakDb="{Binding PostPeakDb}"
                                                  HoldDb="{Binding PostPeakHoldDb}"
                                                  Orientation="Vertical"
                                                  Margin="1,0,0,0"
                                                  ToolTip="Post-fader level"/>
                                    <Slider Grid.Column="2"
                                            Orientation="Vertical"
                                            Minimum="0" Maximum="100"
                                            Value="{Binding VolumePercent}"
                                            Margin="3,0,0,0"
                                            VerticalAlignment="Stretch"
                                            ToolTip="{Binding VolumePercent, StringFormat={}{0:F0}%}"/>
                                </Grid>

                                <Grid Grid.Row="3" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource MuteBtn}" IsChecked="{Binding Muted}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Lbl}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding VolumePercent, StringFormat={}{0:F0}%}"/>
                                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Routes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource RouteBtn}"
                                                              Content="{Binding ShortLabel}"
                                                              IsChecked="{Binding IsOn}"
                                                              ToolTip="{Binding Tooltip}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Outputs -->
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Outputs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OutputViewModel}">
                        <Border Style="{StaticResource Strip}" Background="#2A2A36" MinWidth="70">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*" MinHeight="40"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource EditableLabel}"
                                             Text="{Binding CustomLabel, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="20"/>
                                    <Button Grid.Column="1" Style="{StaticResource RecordBtn}"
                                            FontFamily="Segoe UI" FontSize="12"
                                            Content="{Binding RecordIcon}" ToolTip="{Binding RecordTooltip}"
                                            Command="{Binding ToggleRecordCommand}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <ToggleButton x:Name="OutDevBtn" Style="{StaticResource DeviceSelBtn}"
                                                  Content="{Binding SelectedDevice.FriendlyName, FallbackValue='(none)', TargetNullValue='(none)'}"
                                                  ToolTip="{Binding SelectedDevice.FriendlyName, FallbackValue='Click to pick a device'}"/>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=OutDevBtn}"
                                           PlacementTarget="{Binding ElementName=OutDevBtn}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Style="{StaticResource PopupSurface}">
                                            <ListBox Style="{StaticResource PopupList}"
                                                     ItemsSource="{Binding AvailableDevices}"
                                                     SelectedItem="{Binding SelectedDevice}"
                                                     DisplayMemberPath="FriendlyName"
                                                     Tag="{Binding ElementName=OutDevBtn}"
                                                     SelectionChanged="PopupList_SelectionChanged"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ctrl:VuMeter Grid.Column="0"
                                                  PeakDb="{Binding OutputPeakDb}"
                                                  HoldDb="{Binding OutputPeakHoldDb}"
                                                  Orientation="Vertical"
                                                  ToolTip="Output level"/>
                                    <StackPanel Grid.Column="1" Margin="3,0,0,0" VerticalAlignment="Top">
                                        <TextBlock Style="{StaticResource Lbl}" Text="Peak"/>
                                        <TextBlock Foreground="#FFF" FontSize="10"
                                                   Text="{Binding OutputPeakDb, StringFormat={}{0:F1}}"/>
                                        <TextBlock Style="{StaticResource Lbl}" Text="Hold" Margin="0,2,0,0"/>
                                        <TextBlock Foreground="#FFF" FontSize="10"
                                                   Text="{Binding OutputPeakHoldDb, StringFormat={}{0:F1}}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3" Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Lbl}" Text="Vol" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                            Value="{Binding VolumePercent}"
                                            Margin="3,0,0,0" VerticalAlignment="Center"
                                            ToolTip="{Binding VolumePercent, StringFormat={}{0:F0}% output volume}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Lbl}" Margin="3,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding VolumePercent, StringFormat={}{0:F0}%}"/>
                                </Grid>

                                <StackPanel Grid.Row="4" Margin="0,3,0,0">
                                    <TextBlock Style="{StaticResource Lbl}" Text="Auto-mix"/>
                                    <Grid>
                                        <ToggleButton x:Name="AmxBtn" Style="{StaticResource DeviceSelBtn}"
                                                      Content="{Binding CurrentAutoMixLabel}"
                                                      ToolTip="Automixer for this output: Off = straight sum, Share = smooth duck, Gate = one mic at a time"/>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=AmxBtn}"
                                               PlacementTarget="{Binding ElementName=AmxBtn}"
                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                            <Border Style="{StaticResource PopupSurface}">
                                                <ListBox Style="{StaticResource PopupList}" MinWidth="90"
                                                         ItemsSource="{Binding AutoMixModeOptions}"
                                                         SelectedIndex="{Binding AutoMixModeIndex, Mode=TwoWay}"
                                                         Tag="{Binding ElementName=AmxBtn}"
                                                         SelectionChanged="PopupList_SelectionChanged"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <CheckBox Margin="0,3,0,0" IsChecked="{Binding StableHandoff}" IsEnabled="{Binding AutoMixEnabled}"
                                              Foreground="#CCC" FontSize="10"
                                              ToolTip="Hold the selected mic with hysteresis so a brief louder moment on another mic can't steal it — stops a distant speakerphone's AGC pumping in a talker's pause from grabbing the mix. Off = pick the instantaneously loudest mic.">
                                        <TextBlock Text="Stable hand-off" TextTrimming="CharacterEllipsis"/>
                                    </CheckBox>
                                    <CheckBox Margin="0,3,0,0" IsChecked="{Binding ReferenceGuided}" IsEnabled="{Binding AutoMixEnabled}"
                                              Foreground="#CCC" FontSize="10"
                                              ToolTip="Experimental: pick the room mic whose voice best matches the priority (lapel) mic instead of the loudest one — avoids a loud-but-bad speakerphone winning. Needs a priority mic that's hearing the talker; falls back to loudest when none is.">
                                        <TextBlock Text="Match lapel" TextTrimming="CharacterEllipsis"/>
                                    </CheckBox>
                                    <CheckBox Margin="0,3,0,0" IsChecked="{Binding PreferNatural}" IsEnabled="{Binding AutoMixEnabled}"
                                              Foreground="#CCC" FontSize="10"
                                              ToolTip="Experimental (no lapel needed): among mics nearly as loud as the loudest, pick the most natural-sounding one (lowest spectral-flux instability) — avoids an over-processed/scratchy speakerphone. Works for talkers across the room. Lower priority than Match lapel.">
                                        <TextBlock Text="Prefer natural" TextTrimming="CharacterEllipsis"/>
                                    </CheckBox>
                                </StackPanel>

                                <Grid Grid.Row="5" Margin="0,3,0,0" IsEnabled="{Binding AutoMixEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Lbl}" Text="Str" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                            Value="{Binding StrengthPercent}"
                                            Margin="3,0,0,0" VerticalAlignment="Center"
                                            ToolTip="{Binding StrengthPercent, StringFormat={}{0:F0}% duck strength}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DockPanel>
</Window>
