<Window x:Class="AudioMixer.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:AudioMixer.Controls"
        Title="AudioMixer — Diagnostics"
        Background="#1B1B20"
        Width="880" Height="440"
        MinWidth="640" MinHeight="320"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!--
      "Why this mic?" - the automixer's live reasoning, so diagnosing a bad selection no longer means
      reading the /state JSON endpoint from an external tool. Resizable on purpose: the main window is
      fixed-size, and this is the one view that benefits from room.
    -->
    <Window.Resources>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9A9B6"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8D8DE"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Cap}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </Window.Resources>

    <TabControl Background="#16161C" BorderThickness="0">
        <TabItem Header="Why this mic?">
            <DockPanel Margin="8">
        <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Cap}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Rank is the current selection order. A mic can read hot here and still be ducked — automix gain is applied after the meter tap. speech/floor accumulate until reset."/>
            <Button Grid.Column="1" Content="Reset calibration" Margin="8,0,0,0" Padding="8,3"
                    Command="{Binding ResetCalibrationCommand}"
                    ToolTip="Clear the speech/floor histograms on every input. Do this after changing a transmitter's gain — the old readings would otherwise keep dragging the median."/>
        </Grid>

        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Outputs}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#22222A" BorderBrush="#3A3A42" BorderThickness="1"
                            CornerRadius="4" Padding="7,5" Margin="0,0,0,4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CustomLabel}" Foreground="#E8E8EE" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectionVerdict}" Style="{StaticResource Cap}" Margin="8,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="rank" Style="{StaticResource Head}"/>
                <TextBlock Grid.Column="1" Text="mic" Style="{StaticResource Head}"/>
                <TextBlock Grid.Column="2" Text="speech" Style="{StaticResource Head}"
                           ToolTip="Median level of this mic's voiced buffers, in dBFS. This is what transmitter gain is set against — aim for -24, green means within 3 dB of it. A peak meter cannot show this."/>
                <TextBlock Grid.Column="3" Text="floor" Style="{StaticResource Head}"
                           ToolTip="Median level of its non-voiced buffers: the room floor this mic actually hears. Read it with the room empty to derive the automixer's silence floor."/>
                <TextBlock Grid.Column="4" Text="env dB" Style="{StaticResource Head}"/>
                <TextBlock Grid.Column="5" Text="flux-cv" Style="{StaticResource Head}"/>
                <TextBlock Grid.Column="6" Text="corr" Style="{StaticResource Head}"/>
                <TextBlock Grid.Column="7" Text="gain A" Style="{StaticResource Head}"/>
                <TextBlock Grid.Column="8" Text="gain B" Style="{StaticResource Head}"/>
                <TextBlock Grid.Column="9" Text="state" Style="{StaticResource Head}"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DiagnosticRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding RowBackground}" CornerRadius="3" Padding="4,3" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Rank}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Speech}" Style="{StaticResource Cell}"
                                               Foreground="{Binding SpeechBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Floor}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding EnvDb}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding FluxCv}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="6" Text="{Binding Corr}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="7" Text="{Binding GainA}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="8" Text="{Binding GainB}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="9" Text="{Binding State}" Style="{StaticResource Cell}"
                                               Foreground="{Binding StateBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
            </DockPanel>
        </TabItem>

        <TabItem Header="Session">
            <DockPanel Margin="8">
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Cap}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Accumulated since this launch and written to Documents\AudioMixer\sessions every couple of minutes, whether or not recording was armed. Kept 90 days."/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SessionPanel"/>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <TabItem Header="Calibration">
            <DockPanel Margin="8">
                <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Cap}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="Speech should sit in the band. These medians are what every absolute threshold in the automixer is fitted against, so a mic far outside it makes the selector unstable — not just quiet. Cumulative: reset after ANY transmitter gain change."/>
                    <Button Grid.Column="1" Content="Reset calibration" Margin="8,0,0,0" Padding="8,3"
                            Command="{Binding ResetCalibrationCommand}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Channels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#22222A" BorderBrush="#3A3A42" BorderThickness="1"
                                    CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding CustomLabel}" Foreground="#E8E8EE"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ctrl:VuMeter Grid.Column="1" Height="13" Margin="6,0"
                                                  VerticalAlignment="Center" Orientation="Horizontal"
                                                  ShowTargetBand="True"
                                                  PeakDb="{Binding PostPeakDb}" HoldDb="{Binding PostPeakHoldDb}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Cell}"
                                               Text="{Binding CalibrationText}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </TabItem>

        <TabItem Header="Devices">
            <DockPanel Margin="8">
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Cap}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Bus is the Windows device-enumerator name, not a guess from the friendly name — BTHENUM is the only value that means Bluetooth. Endpoint gain is keyed to the endpoint, so it resets when a receiver moves to another USB port."/>
                <DataGrid x:Name="DeviceGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#16161C" RowBackground="#1E1E24" AlternatingRowBackground="#22222A"
                          Foreground="#D8D8DE" BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#2A2A32" HeadersVisibility="Column" FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="*"/>
                        <DataGridTextColumn Header="Bus" Binding="{Binding Bus}" Width="Auto"/>
                        <DataGridTextColumn Header="Gain" Binding="{Binding Gain}" Width="Auto"/>
                        <DataGridTextColumn Header="Bound to" Binding="{Binding BoundTo}" Width="Auto"/>
                        <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="Auto"/>
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
