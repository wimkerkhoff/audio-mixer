<Window x:Class="AudioMixer.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioMixer — Diagnostics"
        Background="#1B1B20"
        Width="720" Height="440"
        MinWidth="560" MinHeight="320"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!--
      "Why this mic?" - the automixer's live reasoning, so diagnosing a bad selection no longer means
      reading the /state JSON endpoint from an external tool. Resizable on purpose: the main window is
      fixed-size, and this is the one view that benefits from room.
    -->
    <Window.Resources>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A94"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8D8DE"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Cap}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Cap}" Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Text="Rank is the current selection order. A mic can read hot here and still be ducked — automix gain is applied after the meter tap."/>

        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Outputs}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#22222A" BorderBrush="#3A3A42" BorderThickness="1"
                            CornerRadius="4" Padding="7,5" Margin="0,0,0,4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CustomLabel}" Foreground="#E8E8EE" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectionVerdict}" Style="{StaticResource Cap}" Margin="8,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="rank" Style="{StaticResource Head}"/>
                <TextBlock Grid.Column="1" Text="mic" Style="{StaticResource Head}"/>
                <TextBlock Grid.Column="2" Text="env dB" Style="{StaticResource Head}"/>
                <TextBlock Grid.Column="3" Text="flux-cv" Style="{StaticResource Head}"/>
                <TextBlock Grid.Column="4" Text="corr" Style="{StaticResource Head}"/>
                <TextBlock Grid.Column="5" Text="gain A" Style="{StaticResource Head}"/>
                <TextBlock Grid.Column="6" Text="gain B" Style="{StaticResource Head}"/>
                <TextBlock Grid.Column="7" Text="state" Style="{StaticResource Head}"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DiagnosticRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding RowBackground}" CornerRadius="3" Padding="4,3" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Rank}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding EnvDb}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding FluxCv}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Corr}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding GainA}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="6" Text="{Binding GainB}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="7" Text="{Binding State}" Style="{StaticResource Cell}"
                                               Foreground="{Binding StateBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
