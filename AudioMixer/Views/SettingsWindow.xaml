<Window x:Class="AudioMixer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioMixer — Settings"
        Background="#1B1B20"
        Width="560" Height="460"
        MinWidth="440" MinHeight="320"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9A9B6"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8EE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#22222A"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8D8DE"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Microphone roles" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Cap}" Margin="0,0,0,6"
                               Text="Which microphone is the presenter's lapel. It is never gated, and it ducks the room mics while the presenter is speaking."/>
                    <ComboBox ItemsSource="{Binding LapelOptions}"
                              SelectedIndex="{Binding LapelIndex, Mode=TwoWay}"
                              FontSize="11" HorizontalAlignment="Left" MinWidth="180"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Microphones" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Cap}" Margin="0,0,0,6"
                               Text="Which device each strip listens to. A two-transmitter receiver in Split mode is one device carrying TX1 on the left and TX2 on the right: bind it to two strips, one set to Left and one to Right."/>
                    <ItemsControl ItemsSource="{Binding Channels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding CustomLabel, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="20" FontSize="11" VerticalAlignment="Center"
                                             Background="#1B1B22" Foreground="#E8E8EF" BorderBrush="#3A3A44"
                                             ToolTip="Name this microphone"/>
                                    <ComboBox Grid.Column="1" Margin="4,0" ItemsSource="{Binding AvailableDevices}"
                                              SelectedItem="{Binding SelectedDevice}"
                                              DisplayMemberPath="FriendlyName" FontSize="11"/>
                                    <ComboBox Grid.Column="2" Width="66" FontSize="11"
                                              SelectedIndex="{Binding SideIndex, Mode=TwoWay}"
                                              IsEnabled="{Binding IsStereoCapture}"
                                              ToolTip="Which transmitter of a split receiver this strip takes">
                                        <ComboBoxItem Content="Stereo"/>
                                        <ComboBoxItem Content="Left"/>
                                        <ComboBoxItem Content="Right"/>
                                    </ComboBox>
                                    <!-- The only way to unbind a strip. Without it a picker can be
                                         re-pointed but never emptied, and since the strip now REMEMBERS
                                         what it wants across a replug, "forget it" had no control at
                                         all: an unplugged receiver would be re-grabbed the moment it
                                         came back, even when the operator had moved on. -->
                                    <Button Grid.Column="3" Content="✕" Width="22" Margin="4,0,0,0"
                                            FontSize="11" Padding="0"
                                            Background="#242A35" Foreground="#C7C7D2" BorderBrush="#3A3A44"
                                            Command="{Binding ClearDeviceCommand}"
                                            ToolTip="Unbind this strip and forget the device it wants"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Bus leveler" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Cap}" Margin="0,0,0,6"
                               Text="Evens out talkers who are quieter, louder or further from a mic. Off by default. Set the idle floor about 6 dB above what the bus meter reads with the room empty, so the leveler holds steady instead of chasing silence."/>
                    <ItemsControl ItemsSource="{Binding Outputs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding LevelerEnabled}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TaggedLabel}" Foreground="#D8D8DE" FontSize="11"
                                                   VerticalAlignment="Center" Margin="6,0,8,0"/>
                                        <ComboBox Width="84" FontSize="11"
                                                  ItemsSource="{Binding LevelerStrengthOptions}"
                                                  SelectedIndex="{Binding LevelerStrengthIndex, Mode=TwoWay}"
                                                  IsEnabled="{Binding LevelerEnabled}"/>
                                        <TextBlock Text="{Binding LevelerGainText}" Style="{StaticResource Cap}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   FontFamily="Consolas"/>
                                    </StackPanel>
                                    <Expander Header="Advanced" Foreground="#9AA0AE" FontSize="10" Margin="22,2,0,0"
                                              IsEnabled="{Binding LevelerEnabled}">
                                        <StackPanel Margin="0,4,0,0">
                                            <TextBlock Style="{StaticResource Cap}" Text="{Binding LevelerThresholdDb, StringFormat=Threshold {0:F0} dBFS}"/>
                                            <Slider Minimum="-60" Maximum="0" Value="{Binding LevelerThresholdDb}"/>
                                            <TextBlock Style="{StaticResource Cap}" Text="{Binding LevelerRatio, StringFormat=Ratio {0:F1}:1}"/>
                                            <Slider Minimum="1" Maximum="10" Value="{Binding LevelerRatio}"/>
                                            <TextBlock Style="{StaticResource Cap}" Text="{Binding LevelerAttackMs, StringFormat=Attack {0:F0} ms}"/>
                                            <Slider Minimum="5" Maximum="500" Value="{Binding LevelerAttackMs}"/>
                                            <TextBlock Style="{StaticResource Cap}" Text="{Binding LevelerReleaseMs, StringFormat=Release {0:F0} ms}"/>
                                            <Slider Minimum="200" Maximum="8000" Value="{Binding LevelerReleaseMs}"/>
                                            <TextBlock Style="{StaticResource Cap}" Text="{Binding LevelerMaxGainDb, StringFormat=Max boost {0:F0} dB}"
                                                       ToolTip="How much the leveler may lift a quiet talker. Room noise rises with it, so 12 dB is the ceiling."/>
                                            <Slider Minimum="0" Maximum="12" Value="{Binding LevelerMaxGainDb}"/>
                                            <TextBlock Style="{StaticResource Cap}" Text="{Binding LevelerIdleFloorDb, StringFormat=Idle hold {0:F0} dBFS}"/>
                                            <Slider Minimum="-70" Maximum="-20" Value="{Binding LevelerIdleFloorDb}"/>
                                            <TextBlock Style="{StaticResource Cap}" Text="{Binding LimiterCeilingDb, StringFormat=Limiter ceiling {0:F1} dBFS}"/>
                                            <Slider Minimum="-12" Maximum="-0.1" Value="{Binding LimiterCeilingDb}"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Mixer" Style="{StaticResource Head}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Mic strips" Style="{StaticResource Cap}" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding InputCountOptions}"
                                  SelectedItem="{Binding InputCount, Mode=TwoWay}" Width="56"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Cap}" Margin="0,0,0,12"
                               Text="How many input strips the mixer shows, 1 to 10."/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Low-cut" Style="{StaticResource Cap}" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding LowCutOptions}"
                                  SelectedIndex="{Binding LowCutIndex, Mode=TwoWay}" Width="72"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Cap}" Margin="0,0,0,12"
                               Text="Applies to every microphone. Removes rumble and handling noise below the cutoff, and stays clear of singing, which starts around 98 Hz. Leave it at 80 Hz unless a microphone is on an instrument."/>

                    <TextBlock Text="Device pickers" Style="{StaticResource Head}"/>
                    <CheckBox IsChecked="{Binding HideVirtualInputs}"
                              Content="Hide virtual devices (VB-CABLE, VoiceMeeter) from input lists"/>
                    <TextBlock Style="{StaticResource Cap}"
                               Text="Hides VB-CABLE and VoiceMeeter from the microphone lists. They stay available as outputs, which is the Zoom path."/>
                    <CheckBox IsChecked="{Binding HideVoicemeeterOutputs}" Margin="0,8,0,0"
                              Content="Hide VoiceMeeter from output lists"/>
                    <TextBlock Style="{StaticResource Cap}"
                               Text="VoiceMeeter installs about ten render endpoints, which buries the two you need. VB-CABLE is left visible: routing a bus into it is the path into Zoom."/>
                    <CheckBox IsChecked="{Binding WarnOnBluetoothMics}" Margin="0,8,0,0"
                              Content="Warn when a microphone is on Bluetooth"/>
                    <TextBlock Style="{StaticResource Cap}"
                               Text="Warn when a microphone is connected over Bluetooth. A Bluetooth mic drops to HSP/HFP quality when used as an input, and adds a second 2.4 GHz radio to the room."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Outputs" Style="{StaticResource Head}"/>
                    <ItemsControl ItemsSource="{Binding Outputs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TaggedLabel}" Foreground="#D8D8DE"
                                               FontSize="11" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDevices}"
                                              SelectedItem="{Binding SelectedDevice}"
                                              DisplayMemberPath="FriendlyName" FontSize="11"/>
                                    <ComboBox Grid.Column="2" Width="60" Margin="4,0,0,0" FontSize="11"
                                              ItemsSource="{Binding AutoMixModeOptions}"
                                              SelectedIndex="{Binding AutoMixModeIndex, Mode=TwoWay}"
                                              ToolTip="Gate follows the talker and mutes the rest. Off passes every routed mic. Scenes set this for you."/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Diagnostics" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Cap}" Text="{Binding DiagnosticsSummary}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
