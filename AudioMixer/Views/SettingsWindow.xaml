<Window x:Class="AudioMixer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioMixer — Settings"
        Background="#1B1B20"
        Width="560" Height="460"
        MinWidth="440" MinHeight="320"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9A9B6"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8EE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#22222A"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8D8DE"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Microphone roles" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Cap}" Margin="0,0,0,6"
                               Text="Which channel is the presenter's lapel. Scenes need this to survive Prayer clearing the priority flag, so it is a property of the mic rather than of the current setup."/>
                    <ComboBox ItemsSource="{Binding LapelOptions}"
                              SelectedIndex="{Binding LapelIndex, Mode=TwoWay}"
                              FontSize="11" HorizontalAlignment="Left" MinWidth="180"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Mixer" Style="{StaticResource Head}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Mic strips" Style="{StaticResource Cap}" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding InputCountOptions}"
                                  SelectedItem="{Binding InputCount, Mode=TwoWay}" Width="56"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Cap}" Margin="0,0,0,12"
                               Text="How many input strips the mixer shows, 1 to 10. Also in the Advanced toolbar — mirrored here because that is where it was looked for and not found."/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Low-cut" Style="{StaticResource Cap}" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding LowCutOptions}"
                                  SelectedIndex="{Binding LowCutIndex, Mode=TwoWay}" Width="72"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Cap}" Margin="0,0,0,12"
                               Text="Applies to every microphone. Removes rumble, HVAC and handling below the cutoff, and sits under congregational singing, whose fundamentals start around 98 Hz. A fixed band, never a gate — it cannot punch holes in sustained material. 80 Hz is right unless a microphone is on an instrument."/>

                    <TextBlock Text="Device pickers" Style="{StaticResource Head}"/>
                    <CheckBox IsChecked="{Binding HideVirtualInputs}"
                              Content="Hide virtual devices (VB-CABLE, VoiceMeeter) from input lists"/>
                    <TextBlock Style="{StaticResource Cap}"
                               Text="Virtual capture devices are never the right microphone. VB-CABLE stays available for outputs — that is the Zoom path."/>
                    <CheckBox IsChecked="{Binding HideVoicemeeterOutputs}" Margin="0,8,0,0"
                              Content="Hide VoiceMeeter from output lists"/>
                    <TextBlock Style="{StaticResource Cap}"
                               Text="VoiceMeeter is itself a mixer — this rig never chains the two — and it installs about ten render endpoints that bury the two that matter. VB-CABLE is NOT hidden: routing a bus into it is the path into Zoom."/>
                    <CheckBox IsChecked="{Binding WarnOnBluetoothMics}" Margin="0,8,0,0"
                              Content="Warn when a microphone is on Bluetooth"/>
                    <TextBlock Style="{StaticResource Cap}"
                               Text="The Ankers must run over their 2.4 GHz Soundsync dongles. A Bluetooth link drops to HSP/HFP quality and adds a second radio that contends with the dongles — it degrades the weakest mic in the room, not necessarily the one on Bluetooth."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Outputs" Style="{StaticResource Head}"/>
                    <ItemsControl ItemsSource="{Binding Outputs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding CustomLabel}" Foreground="#D8D8DE"
                                               FontSize="11" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDevices}"
                                              SelectedItem="{Binding SelectedDevice}"
                                              DisplayMemberPath="FriendlyName" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Diagnostics" Style="{StaticResource Head}"/>
                    <TextBlock Style="{StaticResource Cap}" Text="{Binding DiagnosticsSummary}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
