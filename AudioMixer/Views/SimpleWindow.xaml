<Window x:Class="AudioMixer.Views.SimpleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:AudioMixer.Controls"
        xmlns:v="clr-namespace:AudioMixer.Views"
        Title="AudioMixer"
        Icon="../Assets/app.ico"
        Background="#1B1B20"
        SizeToContent="Height"
        Width="330"
        MinWidth="300"
        ResizeMode="CanMinimize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!--
      Simple mode: the operator runs on ONE monitor shared with OBS, Zoom, YouTube and SermonAudio, so
      this is a narrow dockable panel rather than a console. It surfaces exactly four things: the scene,
      whether audio is flowing, whether the mics are alive, and anything wrong. No per-mic control on
      purpose - to touch a mic you drop into Advanced.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <v:SeverityBrushConverter x:Key="SeverityBrush"/>
        <v:NullToVisibilityConverter x:Key="NullToVis"/>
        <v:MicDotConverter x:Key="MicDot"/>

        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9A9B6"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <!-- Row state stripe. Bound to a STRING because a WPF trigger Value is parsed as one, and
             comparing it against anything else fails silently (see the DataTrigger gotcha). -->
        <Style x:Key="MicRow" TargetType="Border">
            <Setter Property="Background" Value="#22222A"/>
            <Setter Property="BorderBrush" Value="#5A6274"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="live">
                    <Setter Property="BorderBrush" Value="#3FBF7F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="open">
                    <Setter Property="BorderBrush" Value="#4FA3EC"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="dead">
                    <Setter Property="BorderBrush" Value="#E2564D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="off">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BusBtn" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#6B7386"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#3A3A44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2F6FB5"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#3E8BD8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#26262C"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>

        <Style x:Key="SceneBtn" TargetType="Button">
            <Setter Property="Background" Value="#2C2C34"/>
            <Setter Property="Foreground" Value="#D8D8DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3E3E48"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#35353F"/>
                </Trigger>
                <!--
                  Selected state rides on Tag as a STRING. A bool here does not work reliably: XAML
                  parses a trigger's Value as a string and the comparison against a boolean binding is
                  brittle, which silently leaves every button looking unselected.
                -->
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="on">
                    <Setter Property="Background" Value="#2F6F3E"/>
                    <Setter Property="BorderBrush" Value="#3FB950"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource SceneBtn}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <!-- Segoe MDL2 Assets glyphs. The icon itself carries the state (speaker vs speaker-with-slash,
             outline pin vs filled pin), so neither control depends on colour alone to be readable. -->
        <!-- Its OWN template rather than a trigger bolted onto BusBtn: mute and pin share that base,
             and their DataContext has no IsOn, so the bindings failed on every one of them. A WPF
             binding failure is silent, which is exactly why it shipped. -->
        <Style x:Key="RouteBtn" TargetType="ToggleButton" BasedOn="{StaticResource BusBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2F6FB5"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#3E8BD8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <!-- Routed AND currently chosen by the automixer: the mic this bus is
                                 hearing right now. Per-output, because with Gate a different mic can
                                 be live on A than on B and one light on the row cannot say which. -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2E9E63"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#5BE49B"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="b" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#3FBF7F" BlurRadius="7"
                                                          ShadowDepth="0" Opacity="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MuteBtn" TargetType="ToggleButton" BasedOn="{StaticResource BusBtn}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Content" Value="&#xE767;"/>
            <Setter Property="Foreground" Value="#9AA0AE"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="&#xE74F;"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#C8352B"/>
                    <Setter Property="BorderBrush" Value="#E2564D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PinBtn" TargetType="ToggleButton" BasedOn="{StaticResource BusBtn}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Content" Value="&#xE718;"/>
            <Setter Property="Foreground" Value="#9AA0AE"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="&#xE840;"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#2F6FB5"/>
                    <Setter Property="BorderBrush" Value="#3E8BD8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LevelSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="#4FA3EC"/>
            <Setter Property="Background" Value="#15151B"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="5"/>
            <Setter Property="SmallChange" Value="5"/>
            <Setter Property="LargeChange" Value="10"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolBtn" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>

        <!-- The only thing in the panel that says something is wrong, so it changes colour with the
             worst severity rather than sitting quiet. -->
        <Style x:Key="ChecksBtn" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="warn">
                    <Setter Property="Foreground" Value="#E0A33E"/>
                    <Setter Property="BorderBrush" Value="#E0A33E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="bad">
                    <Setter Property="Foreground" Value="#FF8F86"/>
                    <Setter Property="BorderBrush" Value="#E2564D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <StackPanel Margin="8">

        <!-- One toolbar, at the top. No scene heading: the pills below already show which is live,
             and repeating it in words cost two lines of a panel that has to fit beside OBS and Zoom;
             the description moved onto each pill's tooltip, read while deciding rather than after.
             The three doors that used to sit along the bottom are icons here, so actions live in one
             place instead of two ends of the panel. -->
        <Grid Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource ToolBtn}" Content="&#xE72C;" Click="Refresh_Click"
                        ToolTip="Recheck audio devices"/>
                <Button Style="{StaticResource ToolBtn}" Content="&#xE895;" Click="Resync_Click"
                        ToolTip="Resync audio — restart inputs and outputs"/>
                <Button Style="{StaticResource ToolBtn}" Content="&#xE9F5;" Click="ResetCal_Click"
                        ToolTip="Reset calibration — do this after changing a transmitter's gain"/>
                <Rectangle Width="1" Fill="#3A3A44" Margin="3,3"/>
                <Button Style="{StaticResource ToolBtn}" Content="&#xE7F4;" Click="Advanced_Click"
                        ToolTip="Advanced — the full mixer"/>
                <Button Style="{StaticResource ToolBtn}" Content="&#xE9D9;" Click="Diagnostics_Click"
                        ToolTip="Diagnostics — why this mic, session report, calibration, devices"/>
                <Button Style="{StaticResource ToolBtn}" Content="&#xE713;" Click="Settings_Click"
                        ToolTip="Settings"/>
                <Rectangle Width="1" Fill="#3A3A44" Margin="3,3"/>
                <Button Style="{StaticResource ToolBtn}" Content="{Binding RecordIcon}"
                        FontFamily="Segoe UI" Foreground="#E2564D"
                        ToolTip="{Binding RecordTooltip}"
                        Command="{Binding RecordCommand}"/>
                <Button Style="{StaticResource ToolBtn}" Content="&#xE897;" Click="Help_Click"
                        ToolTip="Help — open the documentation"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- With no banner in the panel this badge is the ONLY thing that says something is
                     wrong, so it carries the count and the worst severity, not just a glyph. -->
                <Button x:Name="ChecksButton" Content="{Binding AlertBadgeText}" MinWidth="34" Height="20"
                        FontSize="10" Margin="0,0,3,0" Click="Checks_Click"
                        ToolTip="Checks — what needs attention"
                        Style="{StaticResource ChecksBtn}" Tag="{Binding AlertBadgeState}"/>
                <ToggleButton x:Name="PinButton" Width="24" Height="20"
                              ToolTip="Keep this panel above other windows"
                              Style="{StaticResource PinBtn}"
                              Checked="Pin_Changed" Unchecked="Pin_Changed"/>
            </StackPanel>
        </Grid>

        <!-- Scenes: the one control that matters -->
        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,6">
            <Button Content="Standby" Margin="0,0,3,0" Command="{Binding StandbyCommand}"
                    ToolTip="{Binding Scenes.StandbyTip}"
                    Style="{StaticResource SceneBtn}" Tag="{Binding Scenes.StandbyState}"/>
            <Button Content="Teaching" Margin="0,0,3,0" Command="{Binding TeachingCommand}"
                    ToolTip="{Binding Scenes.TeachingTip}"
                    Style="{StaticResource SceneBtn}" Tag="{Binding Scenes.TeachingState}"/>
            <Button Content="Prayer" Margin="0,0,3,0" Command="{Binding PrayerCommand}"
                    ToolTip="{Binding Scenes.PrayerTip}"
                    Style="{StaticResource SceneBtn}" Tag="{Binding Scenes.PrayerState}"/>
            <Button Content="Singing" Command="{Binding SingingCommand}"
                    ToolTip="{Binding Scenes.SingingTip}"
                    Style="{StaticResource SceneBtn}" Tag="{Binding Scenes.SingingState}"/>
        </UniformGrid>

        <!-- The only operator override, and only where it means something -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,6"
                Visibility="{Binding Scenes.ShowVoiceSource, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="VOICE SOURCE" Style="{StaticResource Cap}" Margin="0,0,0,3"/>
                <UniformGrid Rows="1" Columns="2">
                    <Button Content="Lapel" Margin="0,0,3,0" Command="{Binding UseLapelCommand}"
                            Style="{StaticResource SceneBtn}" Tag="{Binding Scenes.LapelState}"/>
                    <Button Content="Room mics" Command="{Binding UseRoomMicsCommand}"
                            Style="{StaticResource SceneBtn}" Tag="{Binding Scenes.RoomState}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Channel rows: what a physical desk shows, at a width that fits beside OBS and Zoom.
             Width is constant no matter how many mics; it grows downward, which is the direction a
             docked side panel has to spare. -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,6">
            <StackPanel>
                <Grid Margin="0,0,0,3">
                    <TextBlock Text="MICROPHONES" Style="{StaticResource Cap}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="A" Style="{StaticResource Cap}" Width="16" TextAlignment="Center"/>
                        <TextBlock Text="B" Style="{StaticResource Cap}" Width="16" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Channels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MicRow}" Tag="{Binding RowState}" Margin="0,0,0,2">
                                <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding CustomLabel}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="#D8D8E2"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                    <!-- Target band drawn behind the level: "too quiet" becomes a shape
                                         (bar short of the stripe), not a number nobody reads. -->
                                    <ctrl:VuMeter Grid.Column="1" Height="9" Margin="4,0"
                                                  VerticalAlignment="Center"
                                                  Orientation="Horizontal" ShowTargetBand="True"
                                                  PeakDb="{Binding PostPeakDb}"
                                                  HoldDb="{Binding PostPeakHoldDb}"
                                                  ToolTip="Level. The blue band is where speech should sit."/>

                                    <TextBlock Grid.Column="2" Text="{Binding PostPeakDb, StringFormat={}{0:F0}}"
                                               FontFamily="Consolas" FontSize="10" Foreground="#9A9AA6"
                                               VerticalAlignment="Center" TextAlignment="Right"/>

                                    <ToggleButton Grid.Column="3" Width="18" Height="16"
                                                  Margin="3,0,1,0"
                                                  IsChecked="{Binding Muted, Mode=TwoWay}"
                                                  ToolTip="Mute this microphone"
                                                  Style="{StaticResource MuteBtn}"/>

                                    <ItemsControl Grid.Column="4" ItemsSource="{Binding Routes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Content="{Binding ShortLabel}" Width="16" Height="16"
                                                              FontSize="9" Margin="1,0,0,0"
                                                              IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                              ToolTip="{Binding Tooltip}"
                                                              Style="{StaticResource RouteBtn}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <!-- Attenuation only: the fader is percent/100 clamped at 1, so full
                                     is the normal setting and this exists for the one mic that is too
                                     loud, not for balancing. -->
                                <Slider Minimum="0" Maximum="100" Height="14" Margin="56,1,20,0"
                                        Value="{Binding VolumePercent, Mode=TwoWay}"
                                        ToolTip="{Binding VolumeText}"
                                        Style="{StaticResource LevelSlider}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <WrapPanel Margin="0,5,0,0">
                    <TextBlock Text="▌ live now" Foreground="#3FBF7F" FontSize="9" Margin="0,0,10,0"/>
                    <TextBlock Text="▌ open" Foreground="#4FA3EC" FontSize="9" Margin="0,0,10,0"/>
                    <TextBlock Text="▌ no signal" Foreground="#E2564D" FontSize="9" Margin="0,0,10,0"/>
                    <TextBlock Text="▌ off" Foreground="#5A6274" FontSize="9"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- On air, BELOW the mics: signal flows mics -> buses, so the panel reads the same way. Each
             card leads with its bus letter, because routing is spoken as A and B; the device it
             plays to is on the card's tooltip rather than taking a line. -->
        <ItemsControl ItemsSource="{Binding Outputs}" Margin="0,0,0,6">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,4"
                            ToolTip="{Binding DeviceTooltip}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TaggedLabel}"
                                       Foreground="#D8D8DE" FontSize="12"/>
                            <Border Grid.Row="0" Grid.Column="1" CornerRadius="3" Padding="5,1" Margin="4,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#2F6F3E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OnAirState}" Value="MUTED">
                                                <Setter Property="Background" Value="#8B1E26"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OnAirState}" Value="OFF AIR">
                                                <Setter Property="Background" Value="#44484F"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding OnAirState}" Foreground="White" FontSize="9"/>
                            </Border>
                            <ToggleButton Grid.Row="0" Grid.Column="2" Width="20" Height="18"
                                          ToolTip="Mute this output"
                                          IsChecked="{Binding Muted}"
                                          Style="{StaticResource MuteBtn}"/>

                            <ctrl:VuMeter Grid.Row="1" Grid.ColumnSpan="3" Height="7" Margin="0,4,0,0"
                                          PeakDb="{Binding OutputPeakDb}"
                                          HoldDb="{Binding OutputPeakHoldDb}"
                                          Orientation="Horizontal"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>


        <!-- Only what was just said, and only for a few seconds. A permanent line reading "Output B:
             Speakers (...)" is a startup confirmation occupying the one place a refused route or a
             dropped mic has to appear. -->
        <TextBlock Text="{Binding TransientStatus}" Style="{StaticResource Cap}" Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasTransientStatus, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
</Window>
